{
  "name": "plano",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "pnpm --filter @plano/shared build",
    "api:dev": "pnpm --filter @plano/api start:dev",
    "web:dev": "pnpm --filter @plano/web dev",
    "db:up": "pnpm --filter @plano/api db:up",
    "db:down": "pnpm --filter @plano/api db:down",
    "db:migrate": "pnpm --filter @plano/api prisma migrate dev",
    "db:seed": "pnpm --filter @plano/api prisma db seed"
  }
}
