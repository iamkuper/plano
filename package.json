{
  "name": "plano",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "pnpm --filter @plano/shared build",
    "api:dev": "pnpm --filter @plano/api start:dev",
    "web:dev": "pnpm --filter @plano/web dev",
    "db:up": "pnpm --filter @plano/api db:up",
    "db:down": "pnpm --filter @plano/api db:down",
    "db:migrate": "pnpm --filter @plano/api prisma migrate dev",
    "db:seed": "pnpm --filter @plano/api prisma db seed",
    "local:setup": "bash scripts/local-setup.sh",
    "pm2:start": "pm2 start ecosystem.json",
    "pm2:stop": "pm2 stop ecosystem.json",
    "pm2:restart": "pm2 restart ecosystem.json",
    "pm2:delete": "pm2 delete ecosystem.json",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "devDependencies": {
    "pm2": "^7.0.4"
  }
}
