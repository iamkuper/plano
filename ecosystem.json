{
  "apps": [
    {
      "name": "plano-db",
      "script": "apps/api/scripts/dev-postgres.mjs",
      "interpreter": "node",
      "autorestart": true,
      "restart_delay": 3000,
      "max_restarts": 5,
      "kill_timeout": 15000,
      "time": true
    },
    {
      "name": "plano-api",
      "script": "pnpm",
      "args": "--filter @plano/api start:dev",
      "interpreter": "none",
      "autorestart": true,
      "restart_delay": 3000,
      "max_restarts": 10,
      "kill_timeout": 10000,
      "time": true
    },
    {
      "name": "plano-web",
      "script": "pnpm",
      "args": "--filter @plano/web dev",
      "interpreter": "none",
      "autorestart": true,
      "restart_delay": 3000,
      "max_restarts": 10,
      "kill_timeout": 10000,
      "time": true
    }
  ]
}
