# Copy to deploy/api.env on the server. DATABASE_URL, PORT and UPLOAD_DIR are
# set by docker-compose.yml.
NODE_ENV=production
JWT_SECRET=
JWT_EXPIRES_IN=7d
APP_URL=https://plano.team
API_PUBLIC_URL=https://api.plano.team
PLATFORM_ADMIN_EMAILS=iamkuper@yandex.ru

# Mail (invitations, password reset, reminders)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="Plano <hello@plano.team>"

# T-Bank acquiring; without these the built-in test provider is used
# TBANK_TERMINAL_KEY=
# TBANK_PASSWORD=
# TBANK_TAXATION=usn_income
# TBANK_TAX=none

# Seller's details on invoices
SELLER_NAME=
SELLER_INN=
SELLER_OGRN=
SELLER_ADDRESS=
SELLER_BANK=
SELLER_BIK=
SELLER_ACCOUNT=
SELLER_CORR_ACCOUNT=
SELLER_DIRECTOR=
SELLER_VAT=none

# File storage in a private S3 bucket (otherwise files stay on the server disk)
# S3_ENDPOINT=https://s3.twcstorage.ru
# S3_REGION=ru-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
