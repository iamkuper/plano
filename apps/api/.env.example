DATABASE_URL="postgresql://kanban:kanban@localhost:5433/kanban?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3101

# Local test admin for UI checks (created by `pnpm db:seed`). Test-only, never use in production.
TEST_USER_EMAIL="designer@test.local"
TEST_USER_PASSWORD="test-6bc713bc1545"
TEST_USER2_EMAIL="designer2@test.local"
TEST_USER2_PASSWORD="test2-31b432117b"

# Where uploaded files are stored (default: apps/api/uploads).
# UPLOAD_DIR=/var/lib/kanban/uploads

# Billing. Without TBANK_* the built-in test provider is used (no bank needed).
# T-Bank terminal (use the TEST terminal's keys while testing):
# TBANK_TERMINAL_KEY=""
# TBANK_PASSWORD=""
# TBANK_API_URL="https://securepay.tinkoff.ru/v2"
# Public address of this API (the bank posts notifications to <it>/billing/webhooks/tbank)
# API_PUBLIC_URL="https://api.example.com"
# Web app address (bank redirects back here)
# APP_URL="https://app.example.com"
# Fiscal receipt (54-FZ), sent only when set: osn | usn_income | usn_income_outcome | envd | esn | patent
# TBANK_TAXATION=""
# TBANK_TAX="none"
# Test provider only: make renewals fail.
# MOCK_CHARGE_FAIL=1

# Mail (invitations, password reset). Without SMTP_HOST letters are only written to the API log.
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM="Plano <no-reply@example.com>"

# Hidden platform back-office at /platform (not linked in the UI). Comma-separated
# e-mails of accounts that may open it; everyone else gets 404.
# PLATFORM_ADMIN_EMAILS="you@example.com"

# Seller's details for invoices (bank transfer). With SELLER_NAME, SELLER_INN,
# SELLER_BIK and SELLER_ACCOUNT set, invoices are generated as PDF and mailed.
# SELLER_NAME="ИП Иванов Иван Иванович"
# SELLER_INN="771234567890"
# SELLER_KPP=""                      # organisations only
# SELLER_OGRN=""                     # ОГРН / ОГРНИП
# SELLER_ADDRESS="г. Москва, ул. Примерная, д. 1"
# SELLER_BANK="АО «ТБанк», г. Москва"
# SELLER_BIK="044525974"
# SELLER_ACCOUNT="40802810000000000000"
# SELLER_CORR_ACCOUNT="30101810145250000974"
# SELLER_DIRECTOR="Иванов И. И."
# SELLER_ACCOUNTANT=""               # defaults to the director
# SELLER_VAT="none"                  # or a rate included in the price, e.g. 20

# AI agents. Customers enter their own model keys in the interface; they are
# stored encrypted with AGENT_SECRET_KEY (falls back to JWT_SECRET: changing
# that secret makes stored keys unreadable, so set a dedicated one in production).
# AGENT_SECRET_KEY="long-random-string"
# Runs per workspace per day (6 per card per hour is fixed).
# AGENT_RUNS_PER_DAY=300
# Allow agents to call model servers on private addresses (local Ollama etc.). Never in production.
# AGENTS_ALLOW_PRIVATE_URLS=1
