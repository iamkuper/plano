generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-tenant: every top-level row (User, Project, Card, Template, Role)
// belongs to a Workspace; the rest is reached through those. Isolation is
// enforced in src/prisma/tenant.ts. ADMIN manages users and templates of
// their workspace; MEMBER works with boards and cards.
enum UserRole {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  DONE
  ARCHIVED
}

enum UserKind {
  HUMAN
  AGENT
}

enum AgentProvider {
  ANTHROPIC
  OPENAI
  GOOGLE
  OPENAI_COMPATIBLE
}

enum AgentRunStatus {
  RUNNING
  DONE
  FAILED
  SKIPPED
}

enum CardPriority {
  LOW
  MEDIUM
  HIGH
}

model Workspace {
  id             String   @id @default(cuid())
  // Public account number (100001, 100002…): shown to customers, quoted in
  // invoices and support requests. The cuid stays the internal key.
  accountNumber  Int      @unique @default(autoincrement())
  name           String   @default("Канбан")
  // Card key prefix: TSK → TSK-12.
  cardPrefix     String   @default("TSK")
  // Last issued card number; keys are numbered per workspace.
  cardCounter    Int      @default(0)
  // Stages for new projects created without a template.
  defaultColumns String[] @default(["Бэклог", "В работе", "На проверке", "Готово"])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users     User[]
  projects  Project[]
  cards     Card[]
  templates Template[]
  roles     Role[]

  subscription Subscription?
  payments     Payment[]
  invitations  Invitation[]
  labels       Label[]
  customFields CustomField[]
  agentRuns    AgentRun[]
  auditLog     AuditLog[]
}

model User {
  id                 String        @id @default(cuid())
  workspaceId        String
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Globally unique: one account belongs to one workspace.
  email              String        @unique
  passwordHash       String
  name               String
  role               UserRole      @default(MEMBER)
  // For MEMBER: which custom role grants the permissions. ADMIN ignores it.
  roleId             String?
  customRole         Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive           Boolean       @default(true)
  // UI and email language.
  locale             String        @default("ru")
  // AGENT: an AI teammate (no password, works through its AgentProfile).
  kind               UserKind      @default(HUMAN)
  agentProfile       AgentProfile?
  agentRuns          AgentRun[]
  // Mail copies of notifications (assignments, mentions, due dates).
  emailNotifications Boolean       @default(true)
  // Onboarding: the welcome dialog was shown / the checklist was closed.
  welcomeSeenAt      DateTime?
  onboardingClosedAt DateTime?
  // Small square photo as a data: URL (resized client-side to 256px).
  avatarUrl          String?
  createdAt          DateTime      @default(now())

  assignedCards  CardAssignee[]
  comments       Comment[]
  timeEntries    TimeEntry[]
  activity       ActivityLog[]
  notifications  Notification[]  @relation("NotificationRecipient")
  notified       Notification[]  @relation("NotificationActor")
  cardReads      CardRead[]
  attachments    Attachment[]
  passwordResets PasswordReset[]
  auditEntries   AuditLog[]

  @@index([workspaceId])
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  deadline    DateTime?
  hoursBudget Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  board          Board?
  cards          Card[]
  recurringRules RecurringRule[]

  @@index([workspaceId])
}

// A board belongs to a project. The team board is not stored — it is a view
// over cards of all active projects grouped by Column.title.
model Board {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  columns Column[]
}

model Column {
  id       String  @id @default(cuid())
  boardId  String
  board    Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title    String
  // Fractional ordering: inserting between a and b takes (a + b) / 2, so a
  // move updates one row instead of renumbering the whole column.
  position Float
  wipLimit Int?
  // LABEL_COLORS key chosen by the team; null = automatic by position.
  color    String?

  cards Card[]

  @@index([boardId, position])
}

model Card {
  id              String         @id @default(cuid())
  // Human-facing key, shown as <prefix>-<number> (like Jira issue keys).
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Per-workspace key number, assigned in src/prisma/tenant.ts.
  number          Int
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columnId        String
  column          Column         @relation(fields: [columnId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  priority        CardPriority   @default(MEDIUM)
  position        Float
  startDate       DateTime?
  dueDate         DateTime?
  estimateHours   Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  // Set when the card was created by a recurring rule.
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  assignees     CardAssignee[]
  checklist     ChecklistItem[]
  comments      Comment[]
  timeEntries   TimeEntry[]
  activity      ActivityLog[]
  notifications Notification[]
  reads         CardRead[]
  agentRuns     AgentRun[]
  attachments   Attachment[]
  labels        CardLabel[]
  // This card can start only after the cards in `dependsOn` (Gantt arrows).
  fieldValues   CardFieldValue[]
  dependsOn     CardDependency[] @relation("Dependent")
  blocks        CardDependency[] @relation("Blocker")

  @@unique([workspaceId, number])
  @@index([columnId, position])
  @@index([projectId])
}

model CardAssignee {
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
}

model ChecklistItem {
  id       String  @id @default(cuid())
  cardId   String
  card     Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  text     String
  done     Boolean @default(false)
  position Float

  @@index([cardId, position])
}

model Comment {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())

  attachments Attachment[]

  @@index([cardId, createdAt])
}

model TimeEntry {
  id      String   @id @default(cuid())
  cardId  String
  card    Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  minutes Int
  date    DateTime @db.Date
  note    String?

  @@index([cardId])
  @@index([userId, date])
}

model Template {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  // Column titles, in order, created on the new project's board.
  columns     String[]
  createdAt   DateTime  @default(now())

  cards TemplateCard[]

  @@index([workspaceId])
}

model TemplateCard {
  id            String   @id @default(cuid())
  templateId    String
  template      Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  estimateHours Int?
  // Checklist item texts, in order.
  checklist     String[]
  position      Float
}

model ActivityLog {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  // "created" | "moved" | "updated" | "commented" | ...
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([cardId, createdAt])
}

// Workspace-wide settings: a single row with id = 1.
enum NotificationType {
  ASSIGNED // you were made an assignee
  MENTIONED // @you in a discussion message
  COMMENTED // new message on a card you're assigned to
  DUE_SOON // your card is due today or tomorrow (sent by the scheduler)
  OVERDUE // your card became overdue (sent by the scheduler)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  // Null for system reminders (due dates).
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  type      NotificationType
  // Message excerpt for MENTIONED / COMMENTED.
  text      String?
  readAt    DateTime?
  // The due date a reminder was sent for: one reminder per card, person and date.
  dueFor    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, cardId, type, dueFor])
  @@index([userId, readAt, createdAt])
}

// When a user last opened a card's discussion — drives unread counters.
model CardRead {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId String
  card   Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  readAt DateTime @default(now())

  @@id([userId, cardId])
}

// Files on a card; commentId is set when the file was sent in the discussion.
model Attachment {
  id         String   @id @default(cuid())
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  name       String
  mime       String
  size       Int
  // File name inside the uploads directory.
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([cardId])
  @@index([commentId])
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// Creates a fresh card on schedule (e.g. "monthly client report").
model RecurringRule {
  id            String              @id @default(cuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  priority      CardPriority        @default(MEDIUM)
  estimateHours Int?
  assigneeIds   String[]
  checklist     String[]
  frequency     RecurrenceFrequency
  // Every N days/weeks/months.
  interval      Int                 @default(1)
  // WEEKLY: 1 = Monday … 7 = Sunday.
  weekday       Int?
  // MONTHLY: 1–31; short months use their last day.
  monthDay      Int?
  // Due date = creation day + N days.
  dueInDays     Int?
  nextRunAt     DateTime
  lastRunAt     DateTime?
  active        Boolean             @default(true)
  createdById   String
  createdAt     DateTime            @default(now())

  cards Card[]

  @@index([active, nextRunAt])
}

// Custom role ("Сотрудник", "Менеджер"…) with a set of permission keys
// (PERMISSIONS in @plano/shared). "Администратор" is the built-in
// UserRole.ADMIN and isn't stored here.
model Role {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  permissions String[]
  // Given to new staff when no role is chosen.
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  users User[]

  @@unique([workspaceId, name])
}

// ---- Billing ----

enum SubscriptionStatus {
  TRIALING // paid plan on trial, no card yet
  ACTIVE // FREE, or a paid plan within a paid period
  PAST_DUE // renewal charge failed; still has the plan while we retry
  LOCKED // trial or paid period ended unpaid: read-only until paid or moved to FREE
}

enum BillingInterval {
  MONTH
  YEAR
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  CARD // paid on the bank's page
  INVOICE // bank transfer by an invoice; marked paid by the platform owner
}

enum PaymentKind {
  INITIAL // first payment, the customer pays on the bank's page
  RENEWAL // recurring charge by the saved card (no longer created)
  SEATS // extra seats for the rest of the current paid period; `seats` = how many added
}

// Global catalogue (not tenant data), edited in the DB or by migrations.
// Prices are in kopecks per user per month. Storage limit =
// storageMbBase + storageMbPerSeat * active users. Null limit = unlimited.
model Plan {
  id               String   @id
  name             String
  position         Int
  priceKopecks     Int
  maxUsers         Int?
  maxProjects      Int?
  maxRecurring     Int?
  storageMbBase    Int      @default(0)
  storageMbPerSeat Int      @default(0)
  // time, roles, audit, export, api
  features         String[]

  subscriptions Subscription[]
  payments      Payment[]
}

// One per workspace, always present (FREE when nothing is paid).
model Subscription {
  id                 String             @id @default(cuid())
  workspaceId        String             @unique
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(ACTIVE)
  interval           BillingInterval    @default(MONTH)
  // Paid user seats. null on FREE and during a trial (no seat limit then).
  seats              Int?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  // Stop renewing at the end of the paid period and fall back to FREE.
  cancelAtPeriodEnd  Boolean            @default(false)
  // T-Bank token of the saved card, for recurring charges.
  rebillId           String?
  cardMask           String?
  // Period-end reminders already mailed for `endReminderFor`:
  // 1 = "ends in a few days", 2 = "ended, workspace locks soon".
  endReminderFor     DateTime?
  endReminderStage   Int                @default(0)
  failedAttempts     Int                @default(0)
  nextAttemptAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, currentPeriodEnd])
}

model Payment {
  id                String          @id @default(cuid())
  workspaceId       String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind              PaymentKind
  planId            String
  plan              Plan            @relation(fields: [planId], references: [id])
  interval          BillingInterval
  seats             Int
  method            PaymentMethod   @default(CARD)
  // Invoice only: sequential number and the payer's details.
  invoiceNumber     Int?            @unique
  payerName         String?
  payerInn          String?
  payerKpp          String?
  payerAddress      String?
  payerEmail        String?
  // Kopecks.
  amount            Int
  status            PaymentStatus   @default(PENDING)
  // Our id sent to the bank as OrderId.
  orderId           String          @unique
  providerPaymentId String?
  paymentUrl        String?
  failReason        String?
  createdAt         DateTime        @default(now())
  paidAt            DateTime?

  @@index([workspaceId, createdAt])
}

// ---- Invitations and password reset ----

// Only the SHA-256 of a token is stored; the token itself goes into the link.
model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        UserRole  @default(MEMBER)
  roleId      String?
  invitedById String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, acceptedAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ---- Labels ----

// color is a key of LABEL_COLORS (shared); the web maps it to a design token.
model Label {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String
  createdAt   DateTime  @default(now())

  cards CardLabel[]

  @@unique([workspaceId, name])
}

model CardLabel {
  cardId  String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

// Finish-to-start dependency: `card` waits for `dependsOn`. Both cards belong
// to the same project (checked in the service).
model CardDependency {
  cardId      String
  card        Card   @relation("Dependent", fields: [cardId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Card   @relation("Blocker", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([cardId, dependsOnId])
  @@index([dependsOnId])
}

// ---- Custom fields (Business) ----

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

model CustomField {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  type        CustomFieldType
  // Choices of a SELECT field.
  options     String[]
  position    Float
  createdAt   DateTime        @default(now())

  values CardFieldValue[]

  @@unique([workspaceId, name])
}

// One value per card and field; `value` holds a string, number, boolean or
// a YYYY-MM-DD date string depending on the field's type.
model CardFieldValue {
  cardId  String
  card    Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fieldId String
  field   CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value   Json

  @@id([cardId, fieldId])
  @@index([fieldId])
}

// ---- Audit log (Business) ----

// Workspace-level journal: who did what to projects, people, roles and
// settings. Card history lives in ActivityLog. Always recorded; reading it is
// a Business feature.
model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  // e.g. project.create, user.update, role.delete
  action      String
  entityId    String?
  // Human-readable line, e.g. «Проект «Сайт»».
  summary     String
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// Settings of an AI agent: which model it calls, with the customer's own key.
model AgentProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     AgentProvider
  model        String
  // OPENAI_COMPATIBLE only (OpenRouter, DeepSeek, a local server...).
  baseUrl      String?
  // AES-256-GCM sealed API key; never leaves the server.
  apiKeyEnc    String
  keyHint      String
  instructions String        @default("")
  enabled      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// One reaction of an agent to an event on a card (for history, limits and cost).
model AgentRun {
  id           String           @id @default(cuid())
  workspaceId  String
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId      String
  agent        User             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  cardId       String
  card         Card             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  trigger      NotificationType
  status       AgentRunStatus   @default(RUNNING)
  error        String?
  steps        Int              @default(0)
  inputTokens  Int              @default(0)
  outputTokens Int              @default(0)
  createdAt    DateTime         @default(now())
  finishedAt   DateTime?

  @@index([agentId, cardId, createdAt])
  @@index([workspaceId, createdAt])
}
